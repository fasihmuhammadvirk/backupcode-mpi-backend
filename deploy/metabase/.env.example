# =============================================================================
# Metabase droplet env template
# -----------------------------------------------------------------------------
# Copy to `.env` on the droplet and fill in production values:
#     cp .env.example .env
#     chmod 600 .env
#
# Do NOT commit `.env` to git.
# =============================================================================

# -----------------------------------------------------------------------------
# Public URL
# -----------------------------------------------------------------------------
# Domain that points to the droplet (A record).
METABASE_DOMAIN=metabase.example.com

# Full URL Metabase should advertise. Used for password reset emails,
# OAuth redirects, and in the iframe embed contract.
METABASE_SITE_URL=https://metabase.example.com

# Email Let's Encrypt uses for cert expiry notifications.
LETSENCRYPT_EMAIL=ops@example.com

# -----------------------------------------------------------------------------
# Embedding
# -----------------------------------------------------------------------------
# Comma-separated origins allowed to embed Metabase iframes (the React app).
# Examples:
#   MB_EMBEDDING_APP_ORIGIN=https://app.example.com
#   MB_EMBEDDING_APP_ORIGIN=https://app.example.com,https://staging.example.com
MB_EMBEDDING_APP_ORIGIN=https://app.example.com

# Shared secret used to sign embed JWTs. The mpi-backend signs tokens with
# the SAME value (env var: METABASE_SECRET_KEY) and Metabase verifies them.
# Generate with:  openssl rand -hex 32
MB_EMBEDDING_SECRET_KEY=replace-with-openssl-rand-hex-32

# -----------------------------------------------------------------------------
# Metabase application DB (internal Postgres on the droplet)
# -----------------------------------------------------------------------------
# This is Metabase's OWN metadata DB (questions/dashboards/users). It is NOT
# the analytics Postgres. Keep these credentials internal to the droplet.
METABASE_DB_NAME=metabase_app
METABASE_DB_USER=metabase
# Generate with:  openssl rand -base64 32
METABASE_DB_PASSWORD=replace-with-strong-password
